#!/bin/sh
# SPDX-FileCopyrightText: 2026 ccontino84
# SPDX-License-Identifier: LGPL-2.1-only
#
# Run by the RPM on every install and upgrade: creates 00-owlfish.conf, which
# makes the home screen start the add-ons, Owlfish among them, through the
# lipstickaddons loader (lipstick-addons.md), unless the device's own
# configuration already sets QT_QPA_GENERIC_PLUGINS. Owlfish then stays
# inactive instead of taking the device's plugins away (a port's touch or
# keyboard input, for example). Never fails the installation; exits 1 on a
# conflict.
#
#   update-env [directory, default /var/lib/environment/compositor]
#
# POSIX sh: RPM scriptlets may run in BusyBox.

dir=${1:-/var/lib/environment/compositor}
own=00-owlfish.conf
ours=lipstickaddons

# The value lipstick gets without Owlfish, the way systemd reads
# EnvironmentFile=-.../*.conf: files sorted by name, the last assignment wins.
# 90-owlfish.conf is the file of Owlfish 1.1.0 and earlier, which is still
# there while an upgrade runs.
value=
source=
for file in "$dir"/*.conf; do
    [ -f "$file" ] || continue
    case ${file##*/} in
        "$own"|90-owlfish.conf) continue ;;
    esac
    pattern='^[[:space:]]*QT_QPA_GENERIC_PLUGINS[[:space:]]*='
    grep -q "$pattern" "$file" || continue
    value=$(sed -n "s/$pattern[[:space:]]*//p" "$file" | tail -n 1 \
            | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/")
    source=$file
done

# Only the add-ons' own keys (with or without a specification) are ours to
# replace, such as another add-on's file (Frogfish's 01-frogfish.conf);
# anything else belongs to the device. A device list that already starts
# Owlfish is fine too (a hand-made file).
conflict=
loads=
for plugin in $(printf '%s' "$value" | tr 'A-Z' 'a-z' | tr ',' ' '); do
    case ${plugin%%:*} in
        owlfish|lipstickaddons|lipstickaddon-owlfish) loads=1 ;;
        frogfish|lipstickaddon-*) ;;
        *) conflict=1 ;;
    esac
done
if [ -n "$conflict" ] && [ -z "$loads" ]; then
    rm -f "$dir/$own"
    echo "owlfish: installed but inactive: $source sets QT_QPA_GENERIC_PLUGINS. Please report it at https://github.com/ccontino84/owlfish/issues"
    exit 1
fi
# Older packages created the directory by shipping a file in it
mkdir -p "$dir" \
    && printf 'QT_QPA_GENERIC_PLUGINS=%s\n' "$ours" > "$dir/$own.new" \
    && chmod 644 "$dir/$own.new" \
    && mv -f "$dir/$own.new" "$dir/$own"
